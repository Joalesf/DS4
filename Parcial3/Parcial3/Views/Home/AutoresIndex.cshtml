@model IEnumerable<Parcial3.Models.Autor>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Autores";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Autores</h2>
        <a href="@Url.Action("AutoresCreate", "Home")" class="btn btn-primary">
            ➕ Crear nuevo autor
        </a>
    </div>

    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Nombre</th>
                <th>Apellido</th>
                <th style="width:150px;">Acciones</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.AutorId</td>
                    <td>@item.Nombre</td>
                    <td>@item.Apellido</td>

                    <td>
                        <a href="@Url.Action("AutoresEdit", "Home", new { id = item.AutorId })"
                           class="btn btn-sm btn-warning">
                            ✏ Editar
                        </a>

                        @using (Html.BeginForm("AutoresDelete", "Home", new { id = item.AutorId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('¿Está seguro de eliminar este autor?');">
                                 Eliminar
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table {
        border-radius: 10px;
        overflow: hidden;
    }
</style>
