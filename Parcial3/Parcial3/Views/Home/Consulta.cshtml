@model IEnumerable<Parcial3.Models.Articulo>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Consulta de Artículos";

    var tituloFilter = Request.QueryString["titulo"] ?? "";
    var autorFilter = Request.QueryString["autorId"];
    var revistaFilter = Request.QueryString["revistaId"];
}

<div class="container mt-4">

    <h2 class="fw-bold mb-4">Consulta de Artículos</h2>

    @using (Html.BeginForm("Consulta", "Home", FormMethod.Get))
    {
        <div class="row g-3 mb-3">

            <div class="col-md-4">
                <label class="form-label">Título</label>
                <input type="text" name="titulo" class="form-control"
                       placeholder="Buscar por título..."
                       value="@tituloFilter" />
            </div>

            <div class="col-md-4">
                <label class="form-label">Autor</label>
                @Html.DropDownList(
                    "autorId",
                    new SelectList(ViewBag.Autores as IEnumerable<Parcial3.Models.Autor>, "AutorId", "Nombre", autorFilter),
                    "Todos",
                    new { @class = "form-control" })
            </div>

            <div class="col-md-4">
                <label class="form-label">Revista</label>
                @Html.DropDownList(
                    "revistaId",
                    new SelectList(ViewBag.Revistas as IEnumerable<Parcial3.Models.Revista>, "RevistaId", "NombreRevista", revistaFilter),
                    "Todas",
                    new { @class = "form-control" })
            </div>

        </div>

        <button type="submit" class="btn btn-primary">🔎 Filtrar</button>
    }

    <table class="table table-bordered table-striped table-hover mt-4 shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Resumen</th>
                <th>Año</th>
                <th>Revista</th>
            </tr>
        </thead>

        <tbody>
            @if (Model != null && Model.Any())
            {
                foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ArticuloId</td>
                        <td>@item.Titulo</td>
                        <td>@item.Resumen</td>
                        <td>@item.Año</td>
                        <td>@item.Revista?.NombreRevista</td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="5" class="text-center text-muted py-3">
                        No se encontraron artículos.
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table {
        border-radius: 10px;
        overflow: hidden;
    }
</style>
