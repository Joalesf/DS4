@model IEnumerable<Parcial3.Models.Articulo>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Lista de Artículos";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-3">
        <h2 class="fw-bold">Artículos Científicos</h2>
        <a href="@Url.Action("ArticulosCreate", "Home")" class="btn btn-primary">➕ Crear nuevo artículo</a>
    </div>

    <table class="table table-bordered table-striped shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Título</th>
                <th>Resumen</th>
                <th style="width:150px;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.ArticuloId</td>
                    <td>@item.Titulo</td>
                    <td>@item.Resumen</td>
                    <td>
                        <a href="@Url.Action("ArticulosEdit", "Home", new { id = item.ArticuloId })"
                           class="btn btn-sm btn-warning">✏ Editar</a>

                        @using (Html.BeginForm("ArticulosDelete", "Home", new { id = item.ArticuloId }, FormMethod.Post))
                        {
                            @Html.AntiForgeryToken()
                            <button type="submit" class="btn btn-sm btn-danger"
                                    onclick="return confirm('¿Está seguro de eliminar este artículo?');">
                                🗑 Eliminar
                            </button>
                        }
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

<style>
    .table {
        border-radius: 10px;
        overflow: hidden;
    }
</style>
