@model List<Servicios_Eventos_Api_DS4.Models.Servicio>

<section class="hero-landing">
    <div class="hero-bg"
         style="background-image:url('https://images.unsplash.com/photo-1521737604893-d14cc237f11d?auto=format&fit=crop&w=1600&q=80')">
    </div>

    <div class="hero-overlay"></div>

    <div class="hero-content">
        <h1>Eventos que se viven</h1>
        <p>
            Producción, servicios y experiencias diseñadas
            para momentos que no se olvidan.
        </p>

        <a href="#servicios" class="btn btn-primary hero-btn">
            Explorar servicios
        </a>
    </div>
</section>

<section id="servicios" class="services-section">

    <h2 class="section-title">Nuestros Servicios</h2>
    <p class="section-subtitle">
        Creamos experiencias memorables para cada tipo de evento
    </p>

    <div class="grid">
        @foreach (var s in Model)
        {
            <div class="service-card">
                <div class="service-image">
                    <img src="@(
                        s.Nombre.Contains("Luces")
                            ? "https://images.unsplash.com/photo-1511671782779-c97d3d27a1d4?auto=format&fit=crop&w=800&q=80"
                        : s.Nombre.Contains("Catering")
                            ? "https://images.unsplash.com/photo-1555244162-803834f70033?auto=format&fit=crop&w=800&q=80"
                        : s.Nombre.Contains("Sonido")
                            ? "https://images.unsplash.com/photo-1518972559570-7cc1309f3229?auto=format&fit=crop&w=800&q=80"
                        : s.Nombre.Contains("Sillas")
                            ? "https://images.unsplash.com/photo-1582719478250-c89cae4dc85b?auto=format&fit=crop&w=800&q=80"
                        : "https://images.unsplash.com/photo-1503424886307-b090341d25d1?auto=format&fit=crop&w=800&q=80"
                    )"
                         alt="@s.Nombre" />
                </div>

                <div class="service-body">
                    <h3>@s.Nombre</h3>
                    <p>@s.Descripcion</p>

                    <div class="service-footer">
                        <span class="price">$@s.Precio</span>
                        <a class="btn btn-primary"
                           href="/Servicios/Reservar/@s.ServicioId">
                            Reservar
                        </a>
                    </div>
                </div>
            </div>
        }
    </div>
</section>

<style>
    .hero-landing {
        position: relative;
        height: 60vh;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
    }

    .hero-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        filter: brightness(.55);
    }

    .hero-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(
            135deg,
            rgba(15,23,42,.85),
            rgba(99,102,241,.75)
        );
    }

    .hero-content {
        position: relative;
        z-index: 2;
        text-align: center;
        max-width: 800px;
    }

    .grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 30px;
    }

    .service-card {
        border-radius: 12px;
        overflow: hidden;
        background: #fff;
        box-shadow: 0 10px 25px rgba(0,0,0,.12);
    }

    .service-image img {
        width: 100%;
        height: 220px;
        object-fit: cover;
    }
</style>
