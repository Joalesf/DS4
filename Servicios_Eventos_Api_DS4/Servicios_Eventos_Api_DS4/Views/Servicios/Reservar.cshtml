@{
    ViewBag.Title = "Reservar servicio";
}

<h2>Reservar servicio</h2>

<div class="card">
    <form method="post">

        <input type="hidden" name="servicioId" value="@ViewBag.ServicioId" />

        <label>Nombre del evento</label>
        <input name="titulo" required />

        <label>Fecha del evento</label>
        <input type="date" name="fechaEvento" required />

        <label>Lugar</label>
        <input name="lugar" />

        <label>Cantidad</label>
        <input type="number" name="cantidad" min="1" value="1" required />

        <br /><br />

        <button class="btn btn-primary">Continuar a pago</button>
        <a class="btn btn-secondary" href="/Servicios/Index">Cancelar</a>
    </form>
</div>
