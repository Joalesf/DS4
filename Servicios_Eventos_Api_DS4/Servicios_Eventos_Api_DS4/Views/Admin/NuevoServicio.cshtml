<h2>Nuevo servicio</h2>
<form method="post">
    <label>Nombre</label><br />
    <input name="nombre" required /><br /><br />

    <label>Descripción</label><br />
    <input name="descripcion" /><br /><br />

    <label>Precio</label><br />
    <input name="precio" type="number" step="0.01" required /><br /><br />

    <label>ProveedorId (opcional)</label><br />
    <input name="proveedorId" type="number" /><br /><br />

    <label>Activo</label>
    <input type="checkbox" name="activo" checked /><br /><br />

    <button type="submit">Guardar</button>
</form>
